# Copy to .env and adjust as needed.

# Where Chroma stores its files.
CHROMA_DIR=/data/chroma

# Where FastEmbed caches downloaded embedding models.
FASTEMBED_CACHE_DIR=/data/fastembed_cache

# Ollama endpoint and model. The model must already be pulled on the host:
#   ollama pull qwen2.5:7b
# Inside Docker the URL is http://host.docker.internal:11434 (set by compose).
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Free multilingual dense encoder (German-specialized; runs locally via FastEmbed).
DENSE_MODEL=jinaai/jina-embeddings-v2-base-de

# LangChain RecursiveCharacterTextSplitter (character counts).
CHUNK_SIZE=1500
CHUNK_OVERLAP=300

# Retrieval.
TOP_K=6

# Minimum relevance score (0-1) a chunk needs to be used as evidence and cited.
# Below this it is treated as noise. On-topic chunks score ~0.7+, unrelated ~0.2-0.3.
SCORE_THRESHOLD=0.4

# --- Open WebUI / MCP integration ---

# Model id shown in Open WebUI's model picker (src/api.py).
RAG_MODEL_ID=local-rag

# MCP server bind address (src/mcp_server.py).
MCP_HOST=0.0.0.0
MCP_PORT=9000

# Host headers the MCP server accepts. The SDK's DNS-rebinding protection is on by
# default with an empty allow-list, so every name a client uses must be listed here.
MCP_ALLOWED_HOSTS=localhost:9000,127.0.0.1:9000,rag-mcp:9000,host.docker.internal:9000
